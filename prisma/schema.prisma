// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Users {
  id          Int            @id @default(autoincrement())
  email       String         @unique
  name        String?
  password    String
  introduction String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  status      String         @default("active")
  address     String?
  Phone       String?
  experiences Experiences[]
  projects    Projects[]
  contacts    Contacts[]
  abouts      About[]
  skills      Skills[]
}

model Projects {
  id        Int      @id @default(autoincrement())
  title     String
  type      String
  year      Int
  desc      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")
  user_id   Int
  user      Users    @relation(fields: [user_id], references: [id])
}

model Skills {
  id        Int      @id @default(autoincrement())
  category  String
  items     String
  createdAt DateTime @default(now())
  status    String   @default("active")
  user_id   Int
  user      Users    @relation(fields: [user_id], references: [id])
}

model Experiences {
  id          Int       @id @default(autoincrement())
  company     String
  role        String
  period      String
  location    String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  status      String    @default("active")
  user_id     Int
  user        Users     @relation(fields: [user_id], references: [id])
}

model Contacts {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")
  user_id   Int
  user      Users    @relation(fields: [user_id], references: [id])
}

model About {
  id        Int      @id @default(autoincrement())
  name     String
  year     String
  information String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")
  user_id   Int
  user      Users    @relation(fields: [user_id], references: [id])
}

